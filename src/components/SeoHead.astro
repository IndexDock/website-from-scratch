---
import { siteConfig } from "../data/site";

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  socialImagePath?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
}

const {
  title,
  description = siteConfig.description,
  canonicalPath = Astro.url.pathname,
  socialImagePath = siteConfig.socialImagePath,
  structuredData,
  noindex = false,
} = Astro.props;
const pageTitle = title === siteConfig.name ? title : `${title} | ${siteConfig.name}`;
const metadataBase = siteConfig.siteUrl ? new URL(siteConfig.siteUrl) : undefined;
const effectiveNoindex = noindex || !siteConfig.indexingEnabled;
const canonicalUrl = metadataBase && !effectiveNoindex ? new URL(canonicalPath, metadataBase).href : undefined;
const socialImageUrl = metadataBase ? new URL(socialImagePath, metadataBase).href : undefined;
const encodedStructuredData = structuredData
  ? JSON.stringify(structuredData).replaceAll("<", "\\u003c")
  : undefined;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta
  name="robots"
  content={effectiveNoindex ? "noindex, nofollow" : "index, follow"}
/>
<meta name="theme-color" content="#071634" />
<meta property="og:type" content="website" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
{socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
{socialImageUrl && <meta property="og:image:alt" content={siteConfig.socialImageAlt} />}
{socialImageUrl && <meta property="og:image:width" content="1200" />}
{socialImageUrl && <meta property="og:image:height" content="630" />}
{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
<meta name="twitter:card" content={socialImageUrl ? "summary_large_image" : "summary"} />
{socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
{socialImageUrl && <meta name="twitter:image:alt" content={siteConfig.socialImageAlt} />}
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
<link rel="icon" href={siteConfig.faviconPath} type={siteConfig.faviconType} />
{encodedStructuredData && <script is:inline type="application/ld+json" set:html={encodedStructuredData} />}
