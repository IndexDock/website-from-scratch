---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="The requested IndexDock Starter page could not be found." noindex>
  <section class="not-found">
    <p class="eyebrow">404</p>
    <h1>This page has not docked yet.</h1>
    <p>Return to the setup-success page and continue from there.</p>
    <a class="button button--primary" href="/">Back to the starter</a>
  </section>
</BaseLayout>
