{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Placeholder. Cloudflare names the Worker when the learner creates it, so this cannot
  // ship a matching value; `npm run sync:worker` rewrites it once bootstrap records the
  // repository. See agent/contracts/cloudflare-deployment.md.
  "name": "indexdock-starter-website",
  "compatibility_date": "2026-07-21",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
